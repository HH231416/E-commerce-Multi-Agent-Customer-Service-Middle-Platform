# 复制为 .env 后填写真实值；该文件不包含任何有效凭据。
APP_ENV=production
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_URL=redis://:replace-with-a-long-random-secret@redis:6379/0

# 生产环境必须配置，并由身份服务签发 HS256 访问令牌。
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
POSTGRES_DB=customer_service
POSTGRES_USER=customer_service
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://customer_service:replace-with-a-long-random-secret@postgres:5432/customer_service

# 订单域服务地址由部署环境注入。
ORDER_SERVICE_BASE_URL=https://order-service.internal.example.com
ORDER_SERVICE_TOKEN=

# 知识索引由发布流程预先构建，线上仅加载。
KNOWLEDGE_VERSION=2026-07-19
RAG_RERANKER_ENABLED=true

# 生产环境默认使用 Milvus，相关参数由密钥管理服务注入。
RAG_BACKEND=milvus
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=customer_service_knowledge
MILVUS_IMAGE=milvusdb/milvus:v2.4.0
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5
MINIO_IMAGE=minio/minio:RELEASE.2023-03-20T20-16-18Z
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-secret
